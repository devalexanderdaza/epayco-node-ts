{
  "name": "epayco-sdk-node-ts",
  "version": "1.0.0",
  "description": "Epayco API client for Node.js written in TypeScript with support for CommonJS and ES Modules.",
  "license": "MIT",
  "author": {
    "name": "Epayco",
    "email": "info@epayco.com",
    "url": "https://www.epayco.co"
  },
  "contributors": [
    {
      "name": "Jonathan Aguirre",
      "email": "jaguirre@payco.co",
      "url": "https://www.epayco.co"
    },
    {
      "name": "Jeison Caro",
      "email": "jeison.caro@payco.co",
      "url": "https://www.epayco.co"
    },
    {
      "name": "Ricardo Saldarriaga",
      "email": "ricardo.saldarriaga@payco.co",
      "url": "https://www.epayco.co"
    },
    {
      "name": "Alexander Daza",
      "email": "dev.alexander.daza@gmail.com",
      "url": "https://github.com/devalexanderdaza"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/devalexanderdaza/epayco-node-ts.git"
  },
  "keywords": [
    "Epayco",
    "API",
    "payment",
    "gateway",
    "Node.js",
    "TypeScript",
    "SDK",
    "client"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@types/node": "^18.19.130",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  }
}
